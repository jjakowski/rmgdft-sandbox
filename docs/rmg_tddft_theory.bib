% ---------- Velocity gauge and current ----------

@article{IsmailBeigi1999,
  author  = {Ismail-Beigi, S. and Chang, E. K. and Louie, S. G.},
  title   = {Coupling of Nonlocal Potentials to Electromagnetic Fields},
  journal = {Phys. Rev. Lett.},
  volume  = {87},
  pages   = {087402},
  year    = {2001},
  doi     = {10.1103/PhysRevLett.87.087402},
  note    = {Derives the commutator correction $\ii[V_{\rm NL},\hat{r}]$ to the
             current operator for nonlocal pseudopotentials in periodic systems.}
}

@article{Pickard2003,
  author  = {Pickard, C. J. and Mauri, F.},
