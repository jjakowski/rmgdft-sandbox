}

% ---------- Magnus propagator ----------

@article{Magnus1954,
  author  = {Magnus, W.},
  title   = {On the exponential solution of differential equations for a
             linear operator},
  journal = {Commun. Pure Appl. Math.},
  volume  = {7},
  pages   = {649--673},
  year    = {1954},
  doi     = {10.1002/cpa.3160070404},
  note    = {Original derivation of the Magnus expansion; establishes that
             the solution is expressible as a single exponential (Lie-algebraic).}
}

@article{Blanes2009,
  author  = {Blanes, S. and Casas, F. and Oteo, J. A. and Ros, J.},
  title   = {The Magnus expansion and some of its applications},
  journal = {Phys. Rep.},
  volume  = {470},
  pages   = {151--238},
  year    = {2009},
  doi     = {10.1016/j.physrep.2008.11.001},
  note    = {Comprehensive review of the Magnus expansion and higher-order
             variants; includes numerical propagator comparisons.}
}

% ---------- Pseudopotentials ----------

@article{Hamann1979,
  author  = {Hamann, D. R. and Schluter, M. and Chiang, C.},
  title   = {Norm-Conserving Pseudopotentials},
  journal = {Phys. Rev. Lett.},
  volume  = {43},
  pages   = {1494--1497},
  year    = {1979},
  doi     = {10.1103/PhysRevLett.43.1494},
  note    = {Original norm-conserving pseudopotential construction.
             Establishes the norm-conservation condition that guarantees
             correct linear response (condition 3 in Sec.~3).}
}

@article{Troullier1991,
  author  = {Troullier, N. and Martins, J. L.},
  title   = {Efficient pseudopotentials for plane-wave calculations},
  journal = {Phys. Rev. B},
  volume  = {43},
  pages   = {1993--2006},
  year    = {1991},
  doi     = {10.1103/PhysRevB.43.1993},
  note    = {Troullier-Martins pseudopotentials: optimized NCPP widely used
             in plane-wave and real-space codes. Smaller core radii = more
             transferable; softer cutoff = fewer grid points needed.}
}

@article{Kleinman1982,
  author  = {Kleinman, L. and Bylander, D. M.},
  title   = {Efficacious Form for Model Pseudopotentials},
  journal = {Phys. Rev. Lett.},
  volume  = {48},
  pages   = {1425--1428},
  year    = {1982},
  doi     = {10.1103/PhysRevLett.48.1425},
  note    = {Kleinman-Bylander transformation from semilocal to fully separable
             (rank-1 per channel) form $V_{\rm NL} = \sum D_{lm}|\beta\rangle\langle\beta|$.
             Reduces cost from $O(N^2)$ to $O(N)$ per grid point.}
}

@article{Vanderbilt1990,
  author  = {Vanderbilt, D.},
  title   = {Soft self-consistent pseudopotentials in a generalized eigenvalue
             formalism},
  journal = {Phys. Rev. B},
  volume  = {41},
  pages   = {7892--7895},
  year    = {1990},
  doi     = {10.1103/PhysRevB.41.7892},
  note    = {Ultrasoft pseudopotentials (USPP): relaxes norm conservation,
             introduces augmentation charges $Q_{ij}$ and overlap matrix $S\neq\mathbf{1}$.
             Analogous to the AO-basis overlap in Gaussian DFT. Not used in RMG.}
}

@article{Blochl1994,
  author  = {Bl{\"o}chl, P. E.},
  title   = {Projector augmented-wave method},
  journal = {Phys. Rev. B},
  volume  = {50},
  pages   = {17953--17979},
  year    = {1994},
  doi     = {10.1103/PhysRevB.50.17953},
  note    = {PAW method: all-electron quality with PP efficiency.
             Current operator acquires on-site AE reconstruction terms.
             Not used in RMG.}
}

