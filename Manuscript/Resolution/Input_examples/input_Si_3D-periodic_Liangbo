description="silicon" 
#******** REAL SPACE GRID ********   
wavefunction_grid="24 24 24"  
potential_grid_refinement="2"  

restart_tddft = "false" 
start_mode          ="LCAO Start" 
calculation_mode    ="TDDFT"
kohn_sham_solver    ="multigrid"
subdiag_driver      ="auto"
tddft_steps = "20000"
tddft_time_step = "0.200000"  
tddft_mode = "vector potential"
electric_field_tddft = "0.001 0 0 "
unoccupied_states_per_kpoint = "64"
interpolation_type = "prolong"

use_symmetry = "0"
time_reversal = "false"

#******* Pseudopotentials *******
internal_pseudo_type = "sg15"

#verbose = "true"

#********* K POINT SETUP *********  
kpoint_mesh="16  16  16  "  
kpoint_is_shift="0 0 0" 
kpoint_distribution = "64"
  

#****  LATTICE and ATOMS  ****   
bravais_lattice_type="Cubic Primitive"

crds_units = "Bohr"  
lattice_units = "Bohr"  
a_length="     10.18"
b_length="     10.18"
c_length="     10.18"

atomic_coordinate_type="Cell Relative"

#noncollinear="true"
#spinorbit="true"
# List  atomic symbol, coordinates, and movable flag (1 == movable) 
# symbol and coordinates are required, moveable is optional, default is 1
